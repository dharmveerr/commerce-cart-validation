# Cart Validation App Builder environment sample.
# Copy to .env for local setup only; NEVER commit .env or real credentials.
# In the managed deployment workflow, the stored project credentials are injected automatically.
# Obtain the IMS values from the OAuth Server-to-Server credential in the
# intended Adobe Developer Console organization/project/workspace.

# Action and App Management logging level (non-secret).
LOG_LEVEL=info

# OAuth Server-to-Server IMS credentials used by the installation and cart actions.
AIO_COMMERCE_AUTH_IMS_CLIENT_ID=
AIO_COMMERCE_AUTH_IMS_CLIENT_SECRETS=
AIO_COMMERCE_AUTH_IMS_TECHNICAL_ACCOUNT_ID=
AIO_COMMERCE_AUTH_IMS_TECHNICAL_ACCOUNT_EMAIL=
AIO_COMMERCE_AUTH_IMS_ORG_ID=
AIO_COMMERCE_AUTH_IMS_SCOPES=

# The SDK-managed AIO_COMMERCE_CONFIG_ENCRYPTION_KEY is intentionally omitted:
# it is generated/stored by project setup, not supplied by the developer here.
# enabled and maxCartQuantity are live App Management settings, not env vars.
